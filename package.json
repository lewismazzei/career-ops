{
  "name": "career-ops",
  "version": "1.16.0",
  "description": "AI-powered job search pipeline — works with any AI coding CLI (Claude Code, OpenCode, Gemini, Codex, Qwen)",
  "private": true,
  "scripts": {
    "doctor": "node doctor.mjs",
    "scythe:init": "node scythe.mjs init",
    "scythe:status": "node scythe.mjs status",
    "scythe:scan": "node scythe.mjs scan",
    "scythe:scan:dry": "node scythe.mjs scan --dry-run",
    "scythe:scheduled": "node scythe-scheduled-run.mjs",
    "scythe:scheduled:dry": "node scythe-scheduled-run.mjs --dry-run --skip-deploy",
    "scythe:scheduled:test": "node scythe-scheduled-run.test.mjs",
    "scythe:best-all:test": "node scythe-best-all.test.mjs",
    "scythe:env": "node scythe-env.mjs exports",
    "scythe:web": "npm --prefix scythe-web run dev -- --hostname 0.0.0.0",
    "scythe:web:build": "npm --prefix scythe-web run build",
    "scythe:web:deploy": "npm --prefix scythe-web run deploy",
    "scythe:web:preview": "npm --prefix scythe-web run preview",
    "scythe:web:typecheck": "npm --prefix scythe-web run typecheck",
    "scythe:web:d1:list": "npm --prefix scythe-web run d1:list",
    "scythe:web:d1:migrate": "npm --prefix scythe-web run d1:migrate",
