{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scythe",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-09",
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scythe",
      "database_id": "6949271e-3b5b-40b6-b593-1954e72a12ea",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "scythe.work",
      "custom_domain": true
    }
  ]
}
